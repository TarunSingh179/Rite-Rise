# Database - Neon.tech PostgreSQL (Development: local, Production: Neon)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/college_network?schema=public"

# NextAuth Configuration
NEXTAUTH_SECRET="your-secret-key-change-in-production"
