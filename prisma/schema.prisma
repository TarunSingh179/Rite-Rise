generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  PROFESSOR
  MANAGEMENT
  ADMIN
}

enum PostType {
  POST
  ARTICLE
  ANNOUNCEMENT
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum Visibility {
  PUBLIC
  PRIVATE
  CONNECTED
}

enum JobType {
  INTERNSHIP
  FULL_TIME
  PART_TIME
  CONTRACT
  RESEARCH
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  username      String    @unique
  password      String
  role          Role      @default(STUDENT)
  firstName     String
  lastName      String
  avatar        String?
  bio           String?   @db.Text
  department    String?
  year          Int?
  graduationYear Int?
  location      String?
  website       String?
  githubUrl     String?
  linkedinUrl   String?
  resumeUrl     String?
  verified      Boolean   @default(false)
  emailVerifiedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  profile         Profile?
  posts           Post[]
  comments        Comment[]
  connectionsFrom Connection[] @relation("UserConnectionsFrom")
  connectionsTo   Connection[] @relation("UserConnectionsTo")
  sentMessages    Message[]    @relation("MessageSender")
  receivedMessages Message[]   @relation("MessageReceiver")
  repos           Repo[]
  collaborations  Collaboration[]
  events          Event[]
  eventAttendees  EventAttendee[]
  skills          UserSkill[]
  endorsements    Endorsement[]
  jobs            Job[]
  jobApplications JobApplication[]
  notifications   Notification[]
  achievements    Achievement[]
  savedPosts      SavedPost[]
  reactions       Reaction[]
  issues          Issue[]
  assignedIssues  Issue[]    @relation("IssueAssignee")
  releases        Release[]
  actorNotifications Notification[] @relation("NotificationActor")
  organizations   OrganizationMember[]
  departments     DepartmentMember[]

  @@index([email])
  @@index([username])
  @@index([role])
  @@index([department])
}

model Profile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pronouns    String?
  phone       String?
  interests   String[]
  languages   String[]
  socialLinks Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Post {
  id          String   @id @default(uuid())
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  type        PostType @default(POST)
  title       String?
  content     String   @db.Text
  images      String[]
  visibility  Visibility @default(PUBLIC)
  tags        String[]
  repoId      String?
  repo        Repo?    @relation(fields: [repoId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  comments    Comment[]
  reactions   Reaction[]
  saves       SavedPost[]
  @@index([authorId])
  @@index([createdAt])
  @@index([type])
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  parentId  String?
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([authorId])
}

model Reaction {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // like, love, insightful, etc.
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
}

model SavedPost {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model Connection {
  id         String           @id @default(uuid())
  fromId     String
  from       User             @relation("UserConnectionsFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId       String
  to         User             @relation("UserConnectionsTo", fields: [toId], references: [id], onDelete: Cascade)
  status     ConnectionStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([fromId, toId])
  @@index([fromId])
  @@index([toId])
  @@index([status])
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  sender     User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  content    String   @db.Text
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

model Repo {
  id          String     @id @default(uuid())
  ownerId     String
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String?    @db.Text
  url         String?
  language    String?
  topics      String[]
  visibility  Visibility @default(PUBLIC)
  stars       Int        @default(0)
  forks       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  posts       Post[]
  collaborators Collaboration[]
  issues      Issue[]
  releases    Release[]

  @@unique([ownerId, name])
  @@index([ownerId])
}

model Collaboration {
  id        String   @id @default(uuid())
  repoId    String
  repo      Repo     @relation(fields: [repoId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("contributor")
  createdAt DateTime @default(now())

  @@unique([repoId, userId])
}

model Issue {
  id          String   @id @default(uuid())
  repoId      String
  repo        Repo     @relation(fields: [repoId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  status      String   @default("open")
  labels      String[]
  assigneeId  String?
  assignee    User?    @relation("IssueAssignee", fields: [assigneeId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([repoId])
  @@index([status])
}

model Release {
  id          String   @id @default(uuid())
  repoId      String
  repo        Repo     @relation(fields: [repoId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tag         String
  title       String
  description String?  @db.Text
  isLatest    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([repoId])
}

model Event {
  id          String   @id @default(uuid())
  organizerId String
  organizer   User     @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  title       String
  description String   @db.Text
  location    String?
  startTime   DateTime
  endTime     DateTime
  type        String   // seminar, workshop, hackathon, etc.
  capacity    Int?
  image       String?
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attendees   EventAttendee[]

  @@index([organizerId])
  @@index([startTime])
  @@index([type])
}

model EventAttendee {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String   @default("registered") // registered, attended, cancelled
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
}

model Skill {
  id       String      @id @default(uuid())
  name     String      @unique
  category String?
  users    UserSkill[]
  endorsements Endorsement[]

  @@index([category])
}

model UserSkill {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  endorsed  Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([userId, skillId])
}

model Endorsement {
  id         String   @id @default(uuid())
  skillId    String
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  endorserId String
  endorser   User     @relation(fields: [endorserId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([skillId, endorserId])
}

model Job {
  id            String   @id @default(uuid())
  posterId      String
  poster        User     @relation(fields: [posterId], references: [id], onDelete: Cascade)
  title         String
  company       String
  description   String   @db.Text
  type          JobType
  location      String?
  requirements  String[]
  skills        String[]
  salary        String?
  deadline      DateTime?
  applicationLink String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  applications  JobApplication[]

  @@index([posterId])
  @@index([type])
  @@index([isActive])
}

model JobApplication {
  id        String   @id @default(uuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicantId String
  applicant User     @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  coverLetter String? @db.Text
  resumeUrl String?
  status    String   @default("applied") // applied, reviewed, accepted, rejected
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, applicantId])
}

model Notification {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String   // connection, message, like, comment, mention, job, event
  title      String
  content    String   @db.Text
  link       String?
  read       Boolean  @default(false)
  actorId    String?
  actor      User?    @relation("NotificationActor", fields: [actorId], references: [id])
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

model Achievement {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  description String? @db.Text
  icon      String?
  category  String?  // academic, project, community, etc.
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([category])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

model Organization {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?  @db.Text
  type        String   @default("UNIVERSITY") // UNIVERSITY, COLLEGE, CLUB
  website     String?
  logo        String?
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  departments Department[]
  members     OrganizationMember[]
}

model Department {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  members        DepartmentMember[]

  @@unique([organizationId, name])
}

model OrganizationMember {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String       @default("MEMBER") // ADMIN, MODERATOR, MEMBER
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
}

model DepartmentMember {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId   String
  department     Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  role           String       @default("STUDENT") // HEAD, PROFESSOR, STUDENT
  createdAt      DateTime     @default(now())

  @@unique([userId, departmentId])
}
